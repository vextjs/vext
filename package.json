{
  "name": "vextjs",
  "version": "2.0.0",
  "description": "AI-first full-stack Node.js framework for APIs and server-rendered pages with typed contracts, OpenAPI, and machine-readable docs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "require": "./dist/testing/index.cjs",
      "import": "./dist/testing/index.js"
    },
    "./frontend": {
      "types": "./dist/frontend/index.d.ts",
      "require": "./dist/frontend/index.cjs",
      "import": "./dist/frontend/index.js"
    },
    "./style": {
      "types": "./dist/frontend/style/index.d.ts",
      "require": "./dist/frontend/style/index.cjs",
      "import": "./dist/frontend/style/index.js"
    },
    "./adapters/hono": {
      "types": "./dist/adapters/hono/index.d.ts",
      "require": "./dist/adapters/hono/index.cjs",
      "import": "./dist/adapters/hono/index.js"
    },
    "./adapters/fastify": {
      "types": "./dist/adapters/fastify/index.d.ts",
      "require": "./dist/adapters/fastify/index.cjs",
      "import": "./dist/adapters/fastify/index.js"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express/index.d.ts",
      "require": "./dist/adapters/express/index.cjs",
      "import": "./dist/adapters/express/index.js"
    },
    "./adapters/koa": {
      "types": "./dist/adapters/koa/index.d.ts",
      "require": "./dist/adapters/koa/index.cjs",
      "import": "./dist/adapters/koa/index.js"
    },
    "./adapters/native": {
      "types": "./dist/adapters/native/index.d.ts",
      "require": "./dist/adapters/native/index.cjs",
      "import": "./dist/adapters/native/index.js"
    }
  },
  "bin": {
    "vext": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && node scripts/build-cjs.mjs",
    "build:esm": "tsc",
    "build:cjs": "node scripts/build-cjs.mjs",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:int": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:cov": "vitest run --coverage",
    "test:docs:b32:cov": "vitest run --coverage --coverage.include=src/lib/docs/sources/source-registry.ts --coverage.thresholds.lines=95 --coverage.thresholds.functions=95 --coverage.thresholds.statements=95 --coverage.thresholds.branches=95 test/unit/docs/source-registry.test.ts test/unit/docs/register-docs-endpoints.test.ts",
    "test:bench": "node test/benchmark/run-adapter-matrix.mjs",
    "generate:benchmark-docs": "node test/benchmark/generate-website-results.mjs",
    "verify:benchmark-docs": "node test/benchmark/generate-website-results.mjs --check",
    "test:bench:fairness": "node test/benchmark/run-native-fairness.mjs",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc -p test/types/tsconfig.json --pretty false",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:local:quick": "bash scripts/ci-local.sh --quick",
    "format": "prettier --write .",
    "format:changed": "node scripts/format-check.mjs --write",
    "format:check": "node scripts/format-check.mjs",
    "format:check:all": "prettier --check .",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:preflight:final": "node scripts/release-preflight.mjs --final",
    "release:channel": "node scripts/release-channel.mjs",
    "prepublishOnly": "npm run release:preflight:final",
    "test:audit": "npm run verify:exports && npm run verify:adapters",
    "verify:exports": "node test/verify-package-exports.mjs",
    "verify:package-composition": "node scripts/validation/verify-package-composition.mjs",
    "verify:adapters": "node test/verify-adapters-startup.mjs",
    "verify:benchmark-deps": "node test/benchmark/verify-latest-dependencies.mjs",
    "verify:schema-v3": "node scripts/validation/check-schema-v3-adaptation.mjs",
    "verify:pack-install": "node scripts/validation/verify-packed-install.mjs",
    "verify:docs-contract": "node scripts/validation/verify-documentation-contract.mjs",
    "verify:ci-contract": "node scripts/validation/verify-ci-contract.mjs",
    "verify:release-ancestry": "node scripts/verify-release-ancestry.mjs",
    "verify:response-serializer": "node scripts/validation/benchmark-response-serialization.mjs"
  },
  "keywords": [
    "vext",
    "framework",
    "web",
    "server",
    "http",
    "rest",
    "api",
    "fullstack",
    "frontend",
    "react",
    "typed-client",
    "adapter",
    "middleware",
    "plugin",
    "cluster",
    "hot-reload",
    "typescript",
    "node"
  ],
  "author": "rocky <rockyshi1993@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devcodex-labs/vextjs.git"
  },
  "bugs": {
    "url": "https://github.com/devcodex-labs/vextjs/issues"
  },
  "homepage": "https://devcodex-labs.github.io/vextjs/",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "esbuild": "0.28.1",
    "fast-glob": "3.3.3",
    "fast-json-stringify": "7.0.1",
    "flex-rate-limit": "2.2.4",
    "monsqlize": "3.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-refresh": "0.18.0",
    "response-cache-kit": "1.2.1",
    "route-core": "0.0.7",
    "schema-dsl": "3.0.4",
    "sharp": "0.35.3",
    "subset-font": "2.5.0"
  },
  "peerDependencies": {
    "@koa/router": "^15.6.0",
    "express": "^5.0.0",
    "fastify": "^5.0.0",
    "hono": "^4.0.0",
    "koa": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@koa/router": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "koa": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "2.1.1",
    "@koa/router": "15.7.0",
    "@types/express": "5.0.6",
    "@types/koa": "3.0.1",
    "@types/node": "22.19.13",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.9",
    "autocannon": "8.0.0",
    "eslint": "10.2.1",
    "express": "5.2.1",
    "fastify": "5.12.0",
    "hono": "4.13.2",
    "koa": "3.2.1",
    "mongodb-memory-server-core": "11.2.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0",
    "vitest": "4.1.9"
  },
  "overrides": {
    "autocannon@8.0.0": {
      "hyperid": {
        "uuid": "11.1.1"
      }
    }
  },
  "directories": {
    "example": "examples",
    "test": "test"
  }
}
